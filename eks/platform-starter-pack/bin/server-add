#!/bin/sh
# The only server dependency mutation path. Existing compatible pins are retained by uv.
set -eu
cd "$(dirname "$0")/.."
dev=
if [ "${1:-}" = --dev ]; then dev=--dev; shift; fi
[ "$#" -gt 0 ] || { echo 'Usage: bin/server-add [--dev] name==X.Y.Z ...' >&2; exit 1; }
for dependency in "$@"; do
  printf '%s\n' "$dependency" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9_.-]*(\[[A-Za-z0-9_,.-]+\])?==[0-9]+\.[0-9]+\.[0-9]+$' || {
    echo 'Use an exact name==X.Y.Z version' >&2; exit 1;
  }
done
(cd server && uv add --no-sync $dev "$@")
./bin/server-install
./bin/server-check
