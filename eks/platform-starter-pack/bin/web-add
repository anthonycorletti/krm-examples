#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
dev=
if [ "${1:-}" = --dev ]; then dev=--dev; shift; fi
[ "$#" -gt 0 ] || { echo 'Usage: bin/web-add [--dev] name@X.Y.Z ...' >&2; exit 1; }
for dependency in "$@"; do
  printf '%s\n' "$dependency" | grep -Eq '^(@[A-Za-z0-9_.-]+/)?[A-Za-z0-9_.-]+@[0-9]+\.[0-9]+\.[0-9]+$' || {
    echo 'Use an exact name@X.Y.Z version' >&2; exit 1;
  }
done
(cd web && bun add --exact --lockfile-only $dev "$@")
./bin/web-install
./bin/web-build
