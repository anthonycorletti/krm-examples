#!/bin/sh
set -eu

: "${AWS_REGION:?Set AWS_REGION}"

eks_root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cluster=${1:-krm-examples}
case "$cluster" in ''|*[!a-zA-Z0-9_-]*) echo 'Invalid cluster name.' >&2; exit 2 ;; esac
umask 077
mkdir -p "$eks_root/.local"

aws eks update-kubeconfig \
  --region "$AWS_REGION" \
  --name "$cluster" \
  --alias "$cluster" \
  --kubeconfig "$eks_root/.local/$cluster.kubeconfig"
