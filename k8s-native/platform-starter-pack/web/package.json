    "format": "prettier --write src vite.config.ts openapi-ts.config.ts package.json tsconfig.json index.html"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "0.577.0",
