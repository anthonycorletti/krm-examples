{
  "name": "platform-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate": "openapi-ts",
    "build": "tsc --noEmit && vite build",
