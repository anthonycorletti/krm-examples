#!/bin/sh
set -eu
name=platform-starter-dev-postgres
image=postgres:17.6-alpine@sha256:ef257d85f76e48da1c64832459b59fcaba1a4dac97bf5d7450c77753542eee94
if docker container inspect "$name" >/dev/null 2>&1; then
  owner=$(docker inspect --format '{{index .Config.Labels "platform-starter-pack"}}' "$name")
  [ "$owner" = true ] || { echo "Container name belongs to another project" >&2; exit 1; }
  docker start "$name" >/dev/null
else
  docker run --detach --name "$name" --label platform-starter-pack=true \
    -e POSTGRES_USER=platform -e POSTGRES_PASSWORD=platform -e POSTGRES_DB=platform \
    -p 127.0.0.1:55432:5432 "$image" >/dev/null
fi
attempt=0
until docker exec "$name" pg_isready -U platform -d platform >/dev/null 2>&1; do
  attempt=$((attempt + 1))
  [ "$attempt" -lt 30 ] || { echo "Postgres did not become ready" >&2; exit 1; }
  sleep 1
done
echo 'Postgres ready on 127.0.0.1:55432 (development credentials only)'
