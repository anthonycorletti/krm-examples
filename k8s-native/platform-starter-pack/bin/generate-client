#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
./bin/export-openapi
cd web
bun run generate
cat > src/client/README.md <<'DOC'
# Generated API client

Generated by bin/generate-client from web/openapi.json using the exact Hey API
version in web/bun.lock. Do not edit generated TypeScript. Runtime authentication
and base URL configuration live in ../session.ts; route loaders/actions consume
the generated SDK. This README is restored by the generation command.

Run bin/client-check to regenerate and detect tracked contract/client changes.
DOC
