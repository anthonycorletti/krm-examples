{
  "realm": "platform",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 86400,
  "roles": {
    "realm": [
      {
        "name": "developer"
      },
      {
        "name": "viewer"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "platform:read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    },
    {
      "name": "platform:verify",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": []
    }
  ],
  "clients": [
    {
      "clientId": "platform-web",
      "publicClient": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "https://web.localhost:5173/auth/callback"
      ],
      "webOrigins": [
        "https://web.localhost:5173"
      ],
      "defaultClientScopes": [
        "platform:read"
      ],
      "optionalClientScopes": [
        "platform:verify"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://web.localhost:5173/connect"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "environment",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "environment",
            "claim.value": "${APP_ENV}",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "platform-cli",
      "publicClient": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "platform:read"
      ],
      "optionalClientScopes": [
        "platform:verify"
      ],
      "attributes": {},
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "platform-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "environment",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "environment",
            "claim.value": "${APP_ENV}",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "platform-mcp-cli",
      "publicClient": true,
      "enabled": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "platform:read"
      ],
      "optionalClientScopes": [
        "platform:verify"
      ],
      "attributes": {},
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "platform-mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "environment",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "environment",
            "claim.value": "${APP_ENV}",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "platform:read",
      "roles": [
        "developer",
        "viewer"
      ]
    },
    {
      "clientScope": "platform:verify",
      "roles": [
        "developer"
      ]
    }
  ],
  "users": [
    {
      "id": "local-developer",
      "username": "developer",
      "enabled": true,
      "email": "developer@localhost",
      "emailVerified": true,
      "firstName": "Developer",
      "lastName": "Local",
      "realmRoles": [
        "developer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_DEVELOPER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "id": "local-viewer",
      "username": "viewer",
      "enabled": true,
      "email": "viewer@localhost",
      "emailVerified": true,
      "firstName": "Viewer",
      "lastName": "Local",
      "realmRoles": [
        "viewer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${KEYCLOAK_VIEWER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ],
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 86400
}
